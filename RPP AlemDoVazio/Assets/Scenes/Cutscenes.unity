      m_Calls: []
  m_text: "Ao passar 3 anos, Jo\xE3o completa 12 anos. O pai Ant\xF4nio distante
    e frio, o observa sem emo\xE7\xE3o. Jo\xE3o se sente triste e incompreendido
    por todo esse desprezo que o pai sente por ele.\r\n"
