  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Em uma bela manh\xE3, o pai de Jo\xE3o pede que ele o acompanhe para buscar
    lenha na floresta. Enquanto caminham, o pai sugere que Jo\xE3o v\xE1 \xE0 frente,
    garantindo que o seguir\xE1 logo atr\xE1s. Por\xE9m, em um piscar de olhos, quando
    Jo\xE3o olha para tr\xE1s, percebe que o pai desapareceu, deixando-o sozinho
    na imensid\xE3o da floresta.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cd6217cc0ecbb824d8bbb6bc3320323f, type: 2}
  m_sharedMaterial: {fileID: -8083344662785193230, guid: cd6217cc0ecbb824d8bbb6bc3320323f, type: 2}
